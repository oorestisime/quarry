{
  "name": "quarry",
  "version": "0.9.1",
  "private": false,
  "description": "Type-safe, ClickHouse-native query builder for TypeScript.",
  "keywords": [
    "analytics",
    "clickhouse",
    "columnar",
    "query",
    "query builder",
    "query-builder",
    "sql",
    "type-safe",
    "type-safety",
    "typescript"
  ],
  "homepage": "https://ch-quarry.vercel.app",
  "bugs": {
    "url": "https://github.com/oorestisime/quarry/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/oorestisime/quarry.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --vitest-plugin -A valid-title src test vitest.config.ts vitest.integration.config.ts vitest.coverage.config.ts",
    "lint:fix": "oxlint --vitest-plugin -A valid-title --fix src test vitest.config.ts vitest.integration.config.ts vitest.coverage.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:performance": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.performance.json --extendedDiagnostics",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  }
}
